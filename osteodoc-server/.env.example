# OsteoDoc Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an

# Server
PORT=3000
NODE_ENV=production

# Datenbank (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=osteodoc
DB_USER=osteodoc
DB_PASSWORD=SICHERES_PASSWORT_HIER_EINTRAGEN

# JWT
JWT_SECRET=ZUFAELLIGER_GEHEIMER_SCHLUESSEL_HIER_EINTRAGEN
JWT_EXPIRES_IN=8h

# Admin-Ersteinrichtung
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ADMIN_PASSWORT_HIER_EINTRAGEN
