<Window x:Class="DesktopAutomatisierung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DesktopAutomatisierung.ViewModels"
        Title="Desktop-Automatisierung – Praxis-Workflow-Manager"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ TOOLBAR ============ -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Desktop-Automatisierung"
                           FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,24,0" />

                <!-- Aufnahme-Steuerung -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,16,0">
                    <Button Content="Aufnahme starten" Style="{StaticResource DangerButton}"
                            Command="{Binding StartRecordingCommand}"
                            IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,0,4,0" />
                    <Button Content="Stopp" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StopRecordingCommand}"
                            IsEnabled="{Binding IsRecording}"
                            Margin="0,0,4,0" />
                    <Button Content="Pause/Weiter" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PauseResumeRecordingCommand}"
                            IsEnabled="{Binding IsRecording}"
                            Margin="0,0,8,0" />
                    <TextBlock Text="{Binding RecordingStatus}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>

                <!-- Wiedergabe-Steuerung -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Geschwindigkeit:" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <ComboBox SelectedValue="{Binding PlaybackSpeed}" Width="60" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ComboBoxItem Content="0.25x" Tag="0.25" />
                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                        <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="5x" Tag="5" />
                    </ComboBox>
                    <Button Content="Abspielen" Style="{StaticResource AccentButton}"
                            Command="{Binding PlayRecordedActionsCommand}"
                            Margin="0,0,4,0" />
                    <Button Content="Stop" Style="{StaticResource DangerButton}"
                            Command="{Binding StopPlaybackCommand}"
                            IsEnabled="{Binding IsPlaying}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ HAUPT-TABS ============ -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Margin="8"
                    BorderThickness="0" Background="Transparent">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="16,8" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ===== TAB 1: RECORDER & EDITOR ===== -->
            <TabItem Header="Aufnahme &amp; Editor">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Aktionsliste -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Aufgezeichnete Aktionen" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding RecordedActionCount, StringFormat=' ({0})'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                           FontSize="13" Margin="4,0,0,0" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Als Funktion speichern" Style="{StaticResource AccentButton}"
                                        Command="{Binding SaveAsFunctionCommand}" Margin="0,0,4,0" />
                                <Button Content="Aktion loeschen" Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteActionCommand}" Margin="0,0,4,0" />
                                <Button Content="Hoch" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding MoveActionUpCommand}" Margin="0,0,4,0" />
                                <Button Content="Runter" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding MoveActionDownCommand}" />
                            </StackPanel>

                            <ListView ItemsSource="{Binding RecordedActions}"
                                      SelectedItem="{Binding SelectedAction}"
                                      BorderThickness="0" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="40"
                                            DisplayMemberBinding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=ListViewItem}, Converter={x:Null}}" />
                                        <GridViewColumn Header="Typ" Width="120" DisplayMemberBinding="{Binding Type}" />
                                        <GridViewColumn Header="Details" Width="300" DisplayMemberBinding="{Binding}" />
                                        <GridViewColumn Header="Delay (ms)" Width="80" DisplayMemberBinding="{Binding DelayMs}" />
                                        <GridViewColumn Header="Fenster" Width="200" DisplayMemberBinding="{Binding WindowTitle}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <!-- Aktions-Details -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedAction}">
                                <TextBlock Text="Aktions-Details" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,0,0,12" Foreground="{StaticResource TextBrush}" />

                                <TextBlock Text="Typ:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <TextBlock Text="Beschreibung:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,8" Padding="4" />

                                <TextBlock Text="Delay (ms):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,8" Padding="4" />

                                <TextBlock Text="Position:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                    <TextBlock Text="X:" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding X}" Width="60" Padding="4" Margin="0,0,8,0" />
                                    <TextBlock Text="Y:" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding Y}" Width="60" Padding="4" />
                                </StackPanel>

                                <TextBlock Text="UI-Element:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding ControlName}" Margin="0,2,0,2" />
                                <TextBlock Text="{Binding AutomationId}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding ControlType}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,8" />

                                <TextBlock Text="Fenster:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,4" Padding="4" />
                                <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,0,8" />

                                <TextBlock Text="Text/Wert:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,4" Padding="4" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,8" Padding="4" />

                                <CheckBox Content="Bei Fehler weitermachen" IsChecked="{Binding ContinueOnError}" Margin="0,0,0,4" />

                                <TextBlock Text="Timeout (ms):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,8" Padding="4" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== TAB 2: BIBLIOTHEK ===== -->
            <TabItem Header="Funktionsbibliothek">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Funktionsliste -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Funktionen" FontSize="15" FontWeight="SemiBold"
                                       Margin="0,0,0,8" Foreground="{StaticResource TextBrush}" />

                            <TextBox DockPanel.Dock="Top" Text="{Binding FunctionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,0,8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchFunctionsCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Ausfuehren" Style="{StaticResource AccentButton}"
                                        Command="{Binding PlayFunctionCommand}" Margin="0,0,4,0" />
                                <Button Content="Duplizieren" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DuplicateFunctionCommand}" Margin="0,0,4,0" />
                                <Button Content="Loeschen" Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteFunctionCommand}" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Functions}"
                                     SelectedItem="{Binding SelectedFunction}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource PrimaryBrush}"
                                                           FontSize="11" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding TargetApplication}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Actions.Count, StringFormat='{}{0} Aktionen'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Funktions-Details -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedFunction}">
                                <TextBlock Text="Funktions-Details" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,0,0,12" Foreground="{StaticResource TextBrush}" />

                                <TextBlock Text="Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" FontSize="14" />

                                <TextBlock Text="Beschreibung:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" TextWrapping="Wrap"
                                         AcceptsReturn="True" MinHeight="60" />

                                <TextBlock Text="Kategorie:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:MainViewModel.Categories}}"
                                          SelectedItem="{Binding Category}"
                                          Margin="0,2,0,8" Padding="8,6" />

                                <TextBlock Text="Zielanwendung:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding TargetApplication, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Prozessname:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding TargetProcessName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Version:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,12" />

                                <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.SaveFunctionCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== TAB 3: WORKFLOWS ===== -->
            <TabItem Header="Workflows">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Workflow-Liste -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Workflows" FontSize="15" FontWeight="SemiBold"
                                       Margin="0,0,0,8" Foreground="{StaticResource TextBrush}" />

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Neu" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding CreateWorkflowCommand}" Margin="0,0,4,0" />
                                <Button Content="Ausfuehren" Style="{StaticResource AccentButton}"
                                        Command="{Binding RunWorkflowCommand}" Margin="0,0,4,0" />
                                <Button Content="Stopp" Style="{StaticResource DangerButton}"
                                        Command="{Binding StopWorkflowCommand}" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Workflows}"
                                     SelectedItem="{Binding SelectedWorkflow}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Steps.Count, StringFormat='{}{0} Schritte'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding LastRunResult}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Workflow-Editor -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                        <DockPanel DataContext="{Binding SelectedWorkflow}">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Workflow-Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" FontSize="14" />
                                <TextBlock Text="Beschreibung:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Funktion als Schritt hinzufuegen" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.AddStepToWorkflowCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="0,0,8,0" />
                            </StackPanel>

                            <ListView ItemsSource="{Binding Steps}" BorderThickness="0" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Schritt" Width="60" DisplayMemberBinding="{Binding SortOrder}" />
                                        <GridViewColumn Header="Typ" Width="120" DisplayMemberBinding="{Binding Type}" />
                                        <GridViewColumn Header="Bezeichnung" Width="250" DisplayMemberBinding="{Binding Label}" />
                                        <GridViewColumn Header="Aktiv" Width="60" DisplayMemberBinding="{Binding Enabled}" />
                                        <GridViewColumn Header="Bei Fehler" Width="120" DisplayMemberBinding="{Binding OnError}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== TAB 4: DIALOG-REGELN ===== -->
            <TabItem Header="Dialog-Regeln">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Dialog-Abfangregeln" FontSize="15" FontWeight="SemiBold"
                                       Margin="0,0,0,8" Foreground="{StaticResource TextBrush}" />

                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Neue Regel" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding AddDialogRuleCommand}" Margin="0,0,4,0" />
                                <Button Content="Loeschen" Style="{StaticResource DangerButton}"
                                        Command="{Binding DeleteDialogRuleCommand}" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding DialogRules}"
                                     SelectedItem="{Binding SelectedDialogRule}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}: {1}">
                                                        <Binding Path="MatchMethod" />
                                                        <Binding Path="MatchPattern" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Action, StringFormat='Aktion: {0}'}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedDialogRule}">
                                <TextBlock Text="Regel-Details" FontSize="15" FontWeight="SemiBold"
                                           Margin="0,0,0,12" Foreground="{StaticResource TextBrush}" />

                                <TextBlock Text="Name:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Erkennungsmethode:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <ComboBox SelectedItem="{Binding MatchMethod}" Margin="0,2,0,8" Padding="8,6" />

                                <TextBlock Text="Suchmuster:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding MatchPattern, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Prozess-Filter:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding ProcessNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Reaktion:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <ComboBox SelectedItem="{Binding Action}" Margin="0,2,0,8" Padding="8,6" />

                                <TextBlock Text="Button-Text (bei ClickButton):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding ButtonText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Prioritaet:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Delay vor Aktion (ms):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding DelayBeforeActionMs, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <TextBlock Text="Cooldown (ms):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CooldownMs, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,2,0,8" />

                                <CheckBox Content="Aktiviert" IsChecked="{Binding Enabled}" Margin="0,0,0,4" />
                                <CheckBox Content="Screenshot bei Ausloesung" IsChecked="{Binding TakeScreenshot}" Margin="0,0,0,4" />
                                <CheckBox Content="Im Log protokollieren" IsChecked="{Binding LogOccurrence}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== TAB 5: SCHEDULER ===== -->
            <TabItem Header="Scheduler">
                <Border Style="{StaticResource Card}" Margin="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Zeitplanung &amp; Events" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <Button Content="Scheduler starten" Style="{StaticResource AccentButton}"
                                    Command="{Binding StartSchedulerCommand}" Margin="0,0,4,0" />
                            <Button Content="Scheduler stoppen" Style="{StaticResource DangerButton}"
                                    Command="{Binding StopSchedulerCommand}" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                            Hier koennen Workflows mit Triggern verknuepft werden:
                            Zeitplaene (taeglich, woechentlich, monatlich, Intervall),
                            Prozess-Events (Start/Stop), Fenster-Events, Datei-Aenderungen
                            oder Hotkeys. Trigger werden direkt am Workflow konfiguriert.
                        </TextBlock>

                        <ListView ItemsSource="{Binding Workflows}" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Workflow" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Trigger-Anzahl" Width="100" DisplayMemberBinding="{Binding Triggers.Count}" />
                                    <GridViewColumn Header="Aktiviert" Width="80" DisplayMemberBinding="{Binding Enabled}" />
                                    <GridViewColumn Header="Letzter Lauf" Width="150" DisplayMemberBinding="{Binding LastRunAt, StringFormat='dd.MM.yyyy HH:mm'}" />
                                    <GridViewColumn Header="Ergebnis" Width="100" DisplayMemberBinding="{Binding LastRunResult}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== TAB 6: LOG ===== -->
            <TabItem Header="Protokoll">
                <Border Style="{StaticResource Card}" Margin="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ausfuehrungsprotokoll" FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8" Foreground="{StaticResource TextBrush}" />

                        <ListBox ItemsSource="{Binding LogMessages}" BorderThickness="0"
                                 Background="Transparent" FontFamily="Consolas" FontSize="12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ============ STATUSLEISTE ============ -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}" Padding="12,6">
            <TextBlock Text="{Binding StatusBarText}" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
</Window>
